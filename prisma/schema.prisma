model Checkin {
  id          Int      @id @default(autoincrement())
  checkinTime DateTime @default(now())

  customerId  Int
  customer    Customer @relation(fields: [customerId], references: [id])

  createdAt   DateTime @default(now())

  @@index([customerId])
}

model Feedback {
  id         Int      @id @default(autoincrement())
  rating     Int
  content    String?
  createdAt  DateTime @default(now())

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model CustomerNote {
  id         Int      @id @default(autoincrement())
  note       String
  createdAt  DateTime @default(now())

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Role   // admin / staff
  createdAt DateTime @default(now())
}